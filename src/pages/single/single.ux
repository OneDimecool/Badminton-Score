<template>
  <div class="page" @swipe="onSwipe" @longpress="onLongPress">
    <text class="score" style = "position: absolute; top:30;" @click="onClickScore">{{ score_opp }}</text>
    <text style="position: absolute;left: 16px;top: 15px;width: 180px;line-height: 32px;font-weight:bold;font-size:24px;color:rgba(255,255,255,0.6);text-align:center;">
      {{nowTime}}
    </text>
    <div class="players-container">
      <div class="players-row">
        <text class="player" @click="setName('s_opp_player_left',opp_player_left)">{{ opp_player_left }}</text>
        <text class="player" @click="setName('s_opp_player_right',opp_player_right)">{{ opp_player_right }}</text>
      </div>
      <div style="position: absolute; align-items: center; padding:5px 50px 5px;"@click="exchangeServePos">
        <img src="../../common/changeserve.png"  />
      </div>
      <div class="players-row">
        <text class="player" @click="setName('s_self_player_left',self_player_left)">{{ self_player_left }}</text>
        <text class="player" @click="setName('s_self_player_right',self_player_right)">{{ self_player_right }}</text>
      </div>
    </div>
    <div class="serve" style = "top:{{lo_servePos_y}}px;left:{{lo_servePos_x}}px" >
      <img class="serve-image" src="../../common/serve.png"></img>
    </div>

      <text class="score" style="position: absolute;top: 410;" @click="onClickScore">{{ score_self }}</text>
  </div>
</template>

<script>
import router from "@system.router";
import storage from '../../utils/storage.js';
import vibrator from '@system.vibrator';
import prompt from '@system.prompt';
import app from '@system.app';
import file from '@system.file';
import brightness from '@system.brightness';
export default {
  // 页面级组件的数据模型，影响传入数据的覆盖机制：private内定义的属性不允许被覆盖
  private: {
    score_opp: 0,
    score_self: 0,
    OperationList: [],
    last_score:"opp", //记录上一次得分方
    opp_player_left: "",
    opp_player_right: "",
    self_player_left: "",
    self_player_right: "",
    nowTime: "00:00",
    servePosParams: {
      opp_left: {x: 56 , y: 190},
      opp_right: {x: 146 , y: 190},
      self_left: {x: 56 , y: 280},
      self_right: {x: 146 , y: 280},
    },
    lo_servePos_x: 0,
    lo_servePos_y: 0,
    lo_servePos: {
      x: 0,
      y: 0
    },
    initialized: false,
  },
  setName(i_player_pos, i_player_name){
    if(i_player_name === "") return;
    this.saveStatus();
    router.push({
      uri: "/pages/setPlayerName",
      params: {
        player_pos: i_player_pos
      }
    });
  },
  resetGame() {
    this.score_opp = 0;
    this.score_self = 0;
    this.last_score = "opp";
    globalThis.servePosName = "opp_left";
    this.updateServePos(globalThis.servePosName);
  },
  checkGameOver() {
    const selfWin = (this.score_self >= 21 && (this.score_self - this.score_opp) >= 2) || this.score_self >= 30;
    const oppWin = (this.score_opp >= 21 && (this.score_opp - this.score_self) >= 2) || this.score_opp >= 30;

    if (selfWin || oppWin) {
      vibrator.vibrate({ mode: 'long' });
      const msg = selfWin ? '己方获胜' : '对方获胜';

      // 弹窗提示 + 按钮重置开局
      prompt.showDialog({
        title: '比赛结束',
        message: msg,
        buttons: [
          { text: '重开', color: '#00C853' },
        ],
        success: (res) => {
          // res.index: 点击按钮下标
          if (res && res.index === 0) {
            this.resetGame();
          }
        }
      });
      return true;
    }
    return false;
  },

  updateServePos(param_name)
  {
      if (this.servePosParams[param_name]) {
          this.lo_servePos_x = this.servePosParams[param_name].x;
          this.lo_servePos_y = this.servePosParams[param_name].y;
          if(param_name === 'self_left')
          {
            this.self_player_left = this.self_player_left === "" ? this.self_player_right : this.self_player_left;
            this.self_player_right = "";
          }
          if(param_name === 'self_right')
          {
            this.self_player_right = this.self_player_right === "" ? this.self_player_left : this.self_player_right;
            this.self_player_left = "";
          }
          if(param_name === 'opp_left')
          {
            this.opp_player_left = this.opp_player_left === "" ? this.opp_player_right : this.opp_player_left;
            this.opp_player_right = "";
          }
          if(param_name === 'opp_right')
          {
            this.opp_player_right = this.opp_player_right === "" ? this.opp_player_left : this.opp_player_right;
            this.opp_player_left = "";
          }
      } else {
          console.error("Invalid serve position parameter: " + param_name);
      }
  },
  onInit() {
    if (!globalThis.servePosName) {
      globalThis.servePosName = "opp_left";
    }
    this.updateServePos(globalThis.servePosName);
    if (!globalThis.opp_player_left || !globalThis.opp_player_right || !globalThis.self_player_left || !globalThis.self_player_right) {
      this.init_player(); 
    }
    this.updatePlayers();
    this.timer = setInterval(() => {
		this.updateTime();
	}, 1000);
  },
  init_player() {
    Promise.all([
      this.getStorage('s_opp_player_left'),
      this.getStorage('s_opp_player_right'),
      this.getStorage('s_self_player_left'),
      this.getStorage('s_self_player_right')
    ]).then((values) => {
      globalThis.s_opp_player_left = values[0] || "拉";
      globalThis.s_opp_player_right = values[1] || "夯";
      globalThis.s_self_player_left = values[2] || "我";
      globalThis.s_self_player_right = values[3] || "友";
      this.updatePlayers();
    }).catch((error) => {
    });
  },
  updateTime() {
		const date = new Date();
		let hours = date.getHours();
		let minutes = date.getMinutes();
    hours = hours < 10 ? '0' + hours : hours;
    minutes = minutes < 10 ? '0' + minutes : minutes;
    this.nowTime = `${hours}:${minutes}`;
		},
  updatePlayers() {
    this.opp_player_left = globalThis.s_opp_player_left;
    this.opp_player_right = globalThis.s_opp_player_right;
    this.self_player_left = globalThis.s_self_player_left;
    this.self_player_right = globalThis.s_self_player_right;
  },
  exchangeServePos(){
    if(globalThis.servePosName === 'self_right' || globalThis.servePosName === 'self_left'){
      if(this.score_opp % 2 === 0){
          globalThis.servePosName = 'opp_left';
          if(this.score_opp > 0) this.last_score = 'opp';
          else this.last_score = '';
      }
      else{
        globalThis.servePosName = 'opp_right';
        this.last_score = 'opp';
      }
      if(this.score_opp > 0) this.last_score = 'opp';
      else this.last_score = '';
    } else if(globalThis.servePosName === 'opp_right' || globalThis.servePosName === 'opp_left'){
      if(this.score_self % 2 === 0){
        globalThis.servePosName = 'self_right';
        this.last_score = 'self';
      }
      else{
        globalThis.servePosName = 'self_left';
      }
      if(this.score_self > 0) this.last_score = 'self';
      else this.last_score = '';
      }
      this.updateServePos(globalThis.servePosName);
  },
  redetermineServePos(){
    if(globalThis.servePosName === 'self_right' || globalThis.servePosName === 'self_left'){
      if(this.score_self % 2 === 0){
          globalThis.servePosName = 'self_right';
      }
      else{
        globalThis.servePosName = 'self_left';
      }
    } else if(globalThis.servePosName === 'opp_right' || globalThis.servePosName === 'opp_left'){
      if(this.score_opp % 2 === 0){
        globalThis.servePosName = 'opp_left';
      }
      else{
        globalThis.servePosName = 'opp_right';
      }
      }
      this.updateServePos(globalThis.servePosName);
  },
  changeServePos(score_side){
    if (score_side === 'self'){
      if(this.score_self % 2 === 0){
          globalThis.servePosName = 'self_right';
      }
      else{
        globalThis.servePosName = 'self_left';
      }
    } else if(score_side === 'opp'){
      if(this.score_opp % 2 === 0){
        globalThis.servePosName = 'opp_left';
      }
      else{
        globalThis.servePosName = 'opp_right';
      }
      }
      this.updateServePos(globalThis.servePosName);
    },
  onSwipe(eve){
    if(eve.direction ==='right'){
      app.terminate();
      return;
    }
    let isGameOver = false;
    isGameOver = this.checkGameOver();
    if(isGameOver){
      return;
    }
    vibrator.vibrate({
      mode: 'short' // 仅指定振动模式
    });
    if(eve.direction === 'up'){
      this.score_self += 1;
      let _score_side = 'self';
      if(this.last_score === _score_side){
        this.self_exchange();
      }
      this.changeServePos(_score_side);
      this.last_score = _score_side;
      console.log(this.last_score)

    } else if(eve.direction === 'down'){
      this.score_opp += 1;
      let _score_side = 'opp';
      if(this.last_score === _score_side){
        this.opp_exchange();
      }
      this.changeServePos(_score_side);
      this.last_score = _score_side;
    } 
    this.checkGameOver()
  },

  onLongPress(eve){
    prompt.showDialog({
        title: '重置比赛',
        message: '是否要重置比赛？',
        buttons: [
          { text: '重开', color: '#00C853' },
        ],
        success: (res) => {
          // res.index: 点击按钮下标
          if (res && res.index === 0) {
            this.resetGame();
          }
        }
      });
  },

  routeDetail() {
    // 跳转到应用内的某个页面，router用法详见：文档->接口->页面路由
    router.push({
      uri: "/pages/detail",
      params: {
        opp_init: this.score_opp,
        self_init: this.score_self
      }
    });
  },

  getStorage(key){
    return new Promise((resolve, reject) => {
      storage.get({
        key: key,
        success: (val) => {
          resolve(val);
        },
      });
    });
  },
  onClickScore(){
    this.saveStatus();
    router.push({
      uri: "/pages/scorePicker",
      params: {
        opp_init: this.score_opp,
        self_init: this.score_self
      }
    });
  },
  onShow(){
    console.log("onShow called");
    if(this.initialized){
    console.log("log to show that onShow is restoring status");
    this.restoreStatus();
  }
    else{
      this.initialized = true;
      setTimeout(() => {
    brightness.setMode({
        mode: 1,
        success: function() {
            console.log('Brightness mode set successfully.');
        },
        fail: function(data, code) {
            console.error(`Failed to set brightness mode, code = ${code}`);
        }
    });
}, 100);
    prompt.showToast({ message:  '已开启屏幕常亮' });
    }
  },
  onDestroy(){
	  if (this.timer) {
      clearInterval(this.timer);
      this.timer = null;
    }
  },
  saveStatus(){
    globalThis.gameStatus = {
      score_opp: this.score_opp,
      score_self: this.score_self,
      last_score: this.last_score,
    };
    globalThis.s_opp_player_left = this.opp_player_left;
    globalThis.s_opp_player_right = this.opp_player_right;
    globalThis.s_self_player_left = this.self_player_left;
    globalThis.s_self_player_right = this.self_player_right;
  },
  restoreStatus(){
    if(globalThis.gameStatus){
      this.score_opp = globalThis.gameStatus.score_opp;
      this.score_self = globalThis.gameStatus.score_self;
      this.last_score = globalThis.gameStatus.last_score;
      this.redetermineServePos();
      this.updateServePos(globalThis.servePosName);
      this.opp_player_left = globalThis.s_opp_player_left;
      this.opp_player_right = globalThis.s_opp_player_right;
      this.self_player_left = globalThis.s_self_player_left;
      this.self_player_right = globalThis.s_self_player_right;
    }
    file.readText({
                uri: 'internal://files/badminton/storage-api/savedFile',
                success: (data) => {
                    console.log("File content after write:", data.text);
                },
                fail: (err) => {
                    console.error("Failed to read file after write:", err);
                }
            });
    Promise.all([
      this.getStorage('s_opp_player_left'),
      this.getStorage('s_opp_player_right'),
      this.getStorage('s_self_player_left'),
      this.getStorage('s_self_player_right')
    ]).then((values) => {
      console.log("Retrieved player names from storage: ", values);
    }).catch((error) => {
      console.log("error to get player names from storage: ", error);
    });
  },
}
</script>

<style>
.page{
  display: flex;
  flex-direction: column;
  width:212px;
  height:520px;
  background-color:#000000;
  justify-content:center;
  align-items: center;
  background-image: url('common/background.png');
  background-position: center;
  background-repeat: no-repeat;
  position:relative;
}
.serve{
  position: absolute;
  z-index: 3;
}

.score{
  font-size: 70px;
  color: #ffffff;
  font-weight:bold;
}


.player {
  font-size: 35px;
  color: #ffffff;
  margin: 10px 12px;
  z-index: 2;
  text-align: center; /* 确保文字居中显示 */

  font-weight:bold;
}

.score-container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100px; /* 控制 score 区域高度 */
}

.score-container.top {
  margin-top: 0px; /* 顶部间距 */
}

.score-container.bottom {
  margin-bottom: -10px; /* 底部间距 */
}

.score {
  font-size: 70px;
  color: #ffffff;
  z-index: 1;
}

.players-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 120px;
  height: 195px;
  flex: 1; /* 占据中间剩余空间 */
  position: absolute;
  background-image: url('common/playground.png');
  background-position: center;
  background-repeat: no-repeat;
}

.players-row {
  display: flex;
  justify-content: center; /* 水平分布 */
  width: 100%;
  margin: 15px;
  gap: 10px; /* 设置两个元素之间的间距 */
}
.center-image-container {
  position: relative; /* 绝对定位 */
  z-index: 1; /* 确保图片在背景图上方 */
}
</style>
